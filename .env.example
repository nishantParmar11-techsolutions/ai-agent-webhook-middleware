# ==============================================================================
# AI Agent Webhook Middleware - Environment Configuration Template
# ==============================================================================
# WARNING: This is a template. DO NOT add live secrets to this file.
# INSTRUCTIONS: Copy this file to '.env' and populate with your actual values.
# ==============================================================================

# --- 1. Core Server Settings ---
# Options: development, staging, production
ENVIRONMENT=production
# Application listening port (Default for Uvicorn is 8000)
PORT=8000
HOST=0.0.0.0

# --- 2. Security & Authentication ---
# Cryptographic shared secret for HMAC-SHA256 webhook signature verification
# Generate a secure key using: openssl rand -hex 32
WEBHOOK_SECRET=your_64_character_hex_string_here

# Comma-separated list of allowed origins for CORS (if web access is needed)
ALLOWED_ORIGINS=https://app.youragency.com,https://api.youragency.com

# --- 3. Downstream Integrations (Routing Destinations) ---
# Where the middleware forwards cleaned/validated data
N8N_WEBHOOK_URL=https://n8n.youragency.com/webhook/incoming-leads
CRM_API_KEY=sk_test_crm_dummy_key_replace_me

# --- 4. Logging & Telemetry ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
