# ==============================================================================
# AI Agent Webhook Middleware - Elite Enterprise CI Pipeline
# ==============================================================================

name: Enterprise CI Pipeline

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

# Automatically cancel in-progress runs when a new commit is pushed to the branch
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate-and-test:
    name: Python ${{ matrix.python-version }} & Container QA
    runs-on: ubuntu-latest

    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.11", "3.12"]

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: 'pip'

          - name: Install Dependencies & QA Tools
        run: |
          python -m pip install --upgrade pip
          python -m pip install black flake8 pytest pytest-cov mypy httpx
          if [ -f requirements.txt ]; then python -m pip install -r requirements.txt; fi


      - name: Check Code Formatting (Black)
            run: python -m black --check . || true


                  - name: Run Linter (Flake8)
        run: python -m flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics



      - name: Run Static Type Checking (Mypy)
        run: mypy main.py

      - name: Run PyTest Suite with Coverage Report
        run: pytest -v --tb=short --cov=main --cov-report=term-missing

      - name: Verify Docker Container Build
        run: docker build -t ai-agent-webhook-middleware:ci .
