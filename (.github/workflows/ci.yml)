# ====================================================================
# AI Agent Webhook Middleware - Enterprise CI/CD Pipeline
# ====================================================================

name: Enterprise CI Pipeline

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate-and-test:
    name: Python ${{ matrix.python-version }} QA & Test Suite
    runs-on: ubuntu-latest

    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.11", "3.12"]

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: 'pip'

      - name: Configure Test Environment
        run: |
          if [ -f .env.example ] && [ ! -f .env ]; then
            cp .env.example .env
          fi

      - name: Install Dependencies & QA Tools
        run: |
          python -m pip install --upgrade pip
          python -m pip install black flake8 pytest pytest-cov pytest-asyncio httpx email-validator mypy
          if [ -f requirements.txt ]; then
            python -m pip install -r requirements.txt
          fi

      - name: Check Code Formatting (Black)
        run: python -m black --check . || true

      - name: Lint Code with Flake8
        run: |
          python -m flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
          python -m flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics

      - name: Run Static Type Checking (Mypy)
        run: python -m mypy main.py || true

      - name: Run PyTest Suite with Coverage Report
        run: python -m pytest -v --tb=short --cov=main --cov-report=term-missing

      - name: Verify Docker Container Build
        if: matrix.python-version == '3.12'
        run: docker build -t ai-agent-webhook-middleware:ci .

